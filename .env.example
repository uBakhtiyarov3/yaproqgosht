# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-your-token
# Bosh menejer(lar) Telegram ID si, vergul bilan bir nechta
ADMIN_IDS=2076925033
# Server domeni (Caddy shu domen uchun SSL oladi), masalan yaproqgosht.duckdns.org
DOMAIN=yaproqgosht.duckdns.org
# Mini app ochiladigan HTTPS manzil (Telegram faqat https qabul qiladi)
WEBAPP_URL=https://yaproqgosht.duckdns.org
# DuckDNS token (ixtiyoriy, IP o'zgarsa domenni yangilash uchun)
DUCKDNS_TOKEN=
# Web server porti
PORT=8080
# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db
# 1 bo'lsa brauzerda initData siz test qilish mumkin (?dev_user=ID). Prod da 0!
DEBUG=0
